@startuml reconcile
!theme plain
title Reconciliation: observations are known present, known absent, unknown or contradictory

participant "curator-dispatcher" as D
database "journal + effect table + records" as J
participant "Helper ledger\n+ start receipts" as H
participant "Broker" as B

D -> J : take the lock; replay the journal; list non-terminal records
loop each record, state by state
  D -> H : observe generation, claim, receipt (by effect id)
  D -> B : observe binding (by effect id)
  alt any observation unknown or contradictory
    D -> J : leave the record; retry later (never relaunch, never declare clean)
  else provisioning, account present, bind unknown→absent
    D -> B : bind if the request is still valid, else retire
  else claim "claimed", no supervisor registration
    D -> J : claim absent (no launch will happen)
  else started, supervisor known absent
    D -> H : exec.stop (same effect id) → outcome lost
  else retiring / cleaning with pending effects
    D -> B : unbind (same effect id)
    D -> H : user.retire (same effect id)
    D -> J : terminal only when both are confirmed
  end
end
@enduml
