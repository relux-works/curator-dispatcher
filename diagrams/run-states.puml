@startuml run-states
!theme plain
title States: allocations (agent/1) and executions (run/1)

state "agent/1" as A {
  [*] --> provisioning
  provisioning --> idle : created + bound
  provisioning --> a_retiring : failure
  idle --> running : execution claimed
  running --> idle : execution finished (kept agent)
  running --> a_retiring : dispatch finished / expired
  idle --> a_retiring : retire / lifetime ended
  state "retiring" as a_retiring
  a_retiring --> removed : unbind + retire confirmed
  a_retiring --> a_failed : (only for a failed provision,\nafter cleanup is confirmed)
  state "failed" as a_failed
}

state "run/1" as R {
  [*] --> accepted
  accepted --> queued : v1, gate closed
  queued --> starting : gate opens, authority re-checked
  queued --> cancelled : cancel / window passed
  accepted --> starting : claim taken
  starting --> running : start receipt recorded
  starting --> stopping : cancel / launch failure
  running --> stopping : exit / cancel / max_runtime
  stopping --> cleaning : termination receipt or exit recorded
  cleaning --> done : obligations confirmed
  cleaning --> cleaning : effect unknown → retry
  done --> [*]
  cancelled --> [*]
}
note bottom of R
  terminal outcome is recorded only after cleanup is confirmed:
  exit | failed | cancelled | expired | lost
end note
@enduml
