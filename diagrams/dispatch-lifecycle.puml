@startuml dispatch-lifecycle
!theme plain
title v0.2: provision an agent, then start one execution (dispatch = both + retire on exit)

participant "Caller" as C
participant "curator-dispatcher\n(swarma-dispatch)" as D
participant "curator-host-helper" as H
participant "Broker" as B
participant "Supervisor" as S
participant "curator-host-launcher" as L
participant "curator-executor\n(agent account)" as E

== provision ==
C -> D : provision {request_id, accounts, …, grants, auth: {key, sig}}
D -> D : reconcile first; prepare: principal ↔ key, signature,\ncaller chain (agent.spawn, credential.lease, depth ≥ 1),\nquotas, constructible leaf; write input/1
alt refused
  D --> C : error {code}
else accepted
  D -> D : capacity claim (owned; v1 may queue)
  D -> H : user.create {kind: agent, label, request_id: effect id}
  H --> D : {uid, generation}
  D -> D : sign leaf agent:<generation> = request ∩ caller ∩ own grant
  D -> B : bind {lease chain, caller chain, intersection, effect id}
  B --> D : binding_id
  D --> C : agent/1 {agent_id, state: idle}
end
== start ==
C -> D : start {request_id, agent_id, plan, digest, auth}
D -> D : re-check authority and lifetime; claim {execution_id, epoch}
D -> S : start supervisor
S -> D : registered (pid, start time) — durable ack
S -> L : sudo launcher  launch.start {generation, execution_id, epoch, executor, plan}
L -> L : write start receipt (pid, start time, boot id)
L -> E : drop to the agent UID, exec (plan on fd 3)
S -> D : receipt recorded → running
E -> E : prepare work dir in the agent home;\nprotected binding; lease; exec harness
... running ...
alt cancel or max_runtime
  S -> H : exec.stop {generation, execution_id}
  H --> S : termination receipt (no process of the execution remains)
else exit
  E --> S : exit status
end
S -> D : outcome; allocation idle (or retiring for dispatch)
@enduml
