@startuml dispatch-lifecycle
!theme plain
title dispatch: prepare → capacity → provision → start → running → cleanup (v0)

participant "Caller\n(curator agent-user)" as C
participant "curator-dispatcher\n(cur-s-dispatch)" as D
participant "curator-host-helper" as H
participant "Broker" as B
participant "Supervisor\n(cur-s-dispatch)" as S
participant "curator-host-launcher" as L
participant "Executor\n(agent account)" as E

C -> D : sudo -u cur-s-dispatch …  (dispatch-request/1:\nrequest_id, profile, harness, accounts, plan, grants)
D -> D : prepare: caller = SUDO_UID; verify caller grant\n(agent.spawn, credential.lease depth ≥ 1); quotas; plan digest
D -> D : capacity: slots, disk, load, hold
alt a gate is closed
  D --> C : refused {capacity:<gate>}  (v1: queued {handle})
end
D -> D : journal: provisioning
D -> H : sudo helper  user.create {kind: agent, label, request_id}
H --> D : {uid, generation g-0193}
D -> D : sign leaf grant: agent:g-0193, depth 0,\n= request ∩ caller grant ∩ own grant
D -> B : bind {uid, generation, chain [leaf, dispatcher grant], request_id}
B --> D : binding_id
D -> D : journal: starting
D -> S : start supervisor for RUN-…
D --> C : run handle {run_id, state: starting}
S -> L : sudo launcher  launch.start {generation, executor, cwd, plan}
L -> E : clear groups, drop to uid 612, exec executor (plan on fd 3)
E -> B : lease (fresh connection) → exec harness
S -> D : journal: running {pid}
... the run works ...
E --> S : exit (code, signal)
S -> D : journal: stopping {exit}
S -> B : unbind
S -> H : user.retire {generation, home: archive}
S -> D : journal: done
@enduml
